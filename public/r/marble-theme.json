  "css": {
    "@keyframes skeleton-sweep": {
      "0%": {
        "translate": "-100% 0"
      },
      "90%,\n    100%": {
        "translate": "100% 0"
      }
    },
    "@keyframes skeleton-reveal": {
      "from": {
        "opacity": "0",
        "translate": "0 6px",
        "filter": "blur(4px)"
      }
    },
    "@keyframes spinner-morph": {
      "0%": {
        "border-radius": "50%",
        "scale": "1",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-out)"
      },
      "8%": {
        "border-radius": "50%",
        "scale": "0.78",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-overshoot)"
      },
      "25%": {
        "border-radius": "12%",
        "scale": "1",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-out)"
      },
      "33%": {
        "border-radius": "12%",
        "scale": "0.78",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-overshoot)"
      },
      "50%": {
        "border-radius": "12%",
        "scale": "0.86",
        "rotate": "45deg",
        "animation-timing-function": "var(--ease-out)"
      },
      "58%": {
        "border-radius": "12%",
        "scale": "0.7",
        "rotate": "45deg",
        "animation-timing-function": "var(--ease-overshoot)"
      },
      "75%": {
        "border-radius": "50% 4% 50% 4%",
        "scale": "1",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-out)"
      },
      "83%": {
        "border-radius": "50% 4% 50% 4%",
        "scale": "0.78",
        "rotate": "0deg",
        "animation-timing-function": "var(--ease-overshoot)"
      },
      "100%": {
        "border-radius": "50%",
        "scale": "1",
        "rotate": "0deg"
      }
    },
    "@utility rim": {
      "&::before": {
        "content": "\"\"",
        "pointer-events": "none",
        "position": "absolute",
        "inset": "0",
        "z-index": "1",
        "border-radius": "inherit",
        "border": "1px solid var(--highlight)",
        "mask-image": "linear-gradient(to bottom, #000, transparent 2.5rem)"
      }
    },
    "@utility rim-none": {
      "&::before": {
        "display": "none"
      }
    },
    "@layer components": {
      "[data-slot=\"chart\"]\n    :is(\n      .recharts-bar-rectangle .recharts-rectangle,\n      .recharts-pie-sector .recharts-sector,\n      .recharts-radial-bar-sector\n    )": {
        "filter": "var(--chart-gloss) drop-shadow(0 2px 0 var(--edge))\n      drop-shadow(0 3px 3px var(--drop))"
      },
      "[data-slot=\"chart\"] .recharts-area-area": {
        "filter": "var(--chart-marble)"
      },
      "[data-slot=\"chart\"] :is(.recharts-line-curve, .recharts-area-curve)": {
        "stroke-linecap": "round",
        "filter": "drop-shadow(0 2px 0 var(--edge))"
      }
    },
    "@utility gloss-sheen": {
      "--gloss-reflection": "linear-gradient(\n    115deg,\n    transparent 14%,\n    color-mix(\n        in oklch,\n        var(--sheen) calc(50% * var(--gloss-strength, 1)),\n        transparent\n      )\n      25%,\n    color-mix(\n        in oklch,\n        var(--sheen) calc(12% * var(--gloss-strength, 1)),\n        transparent\n      )\n      37%,\n    transparent 42%\n  )",
      "background-image": "var(--gloss-reflection)"
    },
    "@utility gloss": {
      "@apply gloss-sheen": {},
      "background-image": "var(--gloss-reflection),\n    linear-gradient(to bottom, transparent 50%, var(--shade) 90%, var(--bounce))"
    },
    "@utility key": {
      "background-color": "var(--face)",
      "background-image": "linear-gradient(\n    to bottom,\n    oklch(1 0 0 / 0.07),\n    transparent 45%,\n    oklch(0 0 0 / 0.1)\n  )"
    },
    "@utility marble": {
      "background-image": "var(--vein)"
    },
    "@utility engraved": {
      "text-shadow": "var(--engrave)"
    },
    "@utility marble-fine": {
      "background-image": "var(--vein-fine)"
    },
    "@utility marble-knob": {
      "background-image": "var(--vein-knob)",
      "background-size": "cover"
    },
    "@layer base": {
      "::-webkit-scrollbar": {
        "width": "12px",
        "height": "12px"
      },
      "::-webkit-scrollbar-track": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-track:vertical": {
        "margin-block": "var(--scrollbar-offset-top, 0.5rem) 0.5rem"
      },
      "::-webkit-scrollbar-track:horizontal": {
        "margin-inline": "0.5rem"
      },
      "::-webkit-scrollbar-thumb": {
        "border": "3px solid transparent",
        "border-radius": "9999px",
        "background-clip": "padding-box",
        "background-color": "color-mix(in oklch, var(--foreground) 20%, transparent)"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "color-mix(in oklch, var(--foreground) 35%, transparent)"
      },
      "::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "@supports not selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "thin",
          "scrollbar-color": "color-mix(in oklch, var(--foreground) 25%, transparent)\n        transparent"
