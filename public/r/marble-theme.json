{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "marble-theme",
  "title": "Marble theme",
  "description": "Tokens, materials, motion and base styles, plus the theme provider (d toggles dark mode).",
  "dependencies": [
    "tw-animate-css@^1.4.0",
    "shadcn@^4.23.0",
    "next-themes@^0.4.6",
    "react-hotkeys-hook@^5.4.0"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/DeeGeeh/marble-ui/master/public/r/utils.json"
  ],
  "files": [
    {
      "path": "components/theme-provider.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { ThemeProvider as NextThemesProvider, useTheme } from \"next-themes\"\nimport { useHotkeys } from \"react-hotkeys-hook\"\n\nfunction ThemeProvider({\n  children,\n  ...props\n}: React.ComponentProps<typeof NextThemesProvider>) {\n  return (\n    <NextThemesProvider\n      attribute=\"class\"\n      defaultTheme=\"light\"\n      enableSystem\n      disableTransitionOnChange\n      {...props}\n    >\n      <ThemeHotkey />\n      <ThemeColor />\n      {children}\n    </NextThemesProvider>\n  )\n}\n\nfunction ThemeHotkey() {\n  const { resolvedTheme, setTheme } = useTheme()\n  useHotkeys(\"d\", () => setTheme(resolvedTheme === \"dark\" ? \"light\" : \"dark\"))\n  return null\n}\n\nfunction ThemeColor() {\n  const { resolvedTheme } = useTheme()\n  React.useEffect(() => {\n    let meta = document.querySelector<HTMLMetaElement>(\n      'meta[name=\"theme-color\"]'\n    )\n    if (!meta) {\n      meta = document.createElement(\"meta\")\n      meta.name = \"theme-color\"\n      document.head.append(meta)\n    }\n    const tag = meta\n    const frame = requestAnimationFrame(() => {\n      tag.content = getComputedStyle(document.body).backgroundColor\n    })\n    return () => cancelAnimationFrame(frame)\n  }, [resolvedTheme])\n  return null\n}\n\nexport { ThemeProvider }\n",
      "type": "registry:component"
    }
  ],
